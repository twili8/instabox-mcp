#!/usr/bin/env python3
import json, os, sys, time, uuid, urllib.request, urllib.error, base64

ENV = os.path.expanduser("~/.config/instabox/env")


def load_env():
    if os.path.exists(ENV):
        with open(ENV) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                os.environ.setdefault(k.strip(), v.strip().strip('"').strip("'"))


def cfg():
    load_env()
    key = os.environ.get("INSTABOX_API_KEY")
    url = os.environ.get("INSTABOX_API_URL", "https://api.instabox.sh").rstrip("/")
    if not key:
        raise RuntimeError("INSTABOX_API_KEY not set")
    return key, url


def api(method, path, body=None, timeout=120, headers=None, query=None):
    key, url = cfg()
    if query:
        path = path + "?" + "&".join(f"{k}={urllib.request.quote(str(v))}" for k, v in query.items())
    h = {"X-API-Key": key, "Accept": "application/json"}
    if headers:
        h.update(headers)
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        h.setdefault("Content-Type", "application/json")
    r = urllib.request.Request(url + path, data=data, headers=h, method=method)
    try:
        with urllib.request.urlopen(r, timeout=timeout) as resp:
            raw = resp.read()
            return resp.status, (json.loads(raw) if raw else None)
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            obj = json.loads(raw)
        except Exception:
            obj = raw.decode(errors="replace")
        raise RuntimeError(f"HTTP {e.code}: {json.dumps(obj)}")


def poll(op_id, timeout=300):
    deadline = time.time() + timeout
    while time.time() < deadline:
        _, op = api("GET", f"/v1/operations/{op_id}", timeout=30)
        if op.get("state") in ("succeeded", "failed"):
            return op
        time.sleep(2)
    raise RuntimeError(f"timed out waiting for {op_id}")


